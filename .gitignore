# Generated by tools/verify_vein_parity.py when the C++ dump disagrees
/tests/fixtures/game/vein-parity-cpp.txt

# Bulk dumps produced while investigating float divergence.  They are large
# (tens of MB) and regenerable by re-running tools/vein-oracle-mod, so only the
# compact reference files are worth committing.
/tests/fixtures/game/height-*.bin
/tests/fixtures/game/biomo-*.bin
/tests/fixtures/game/meta-parity-game.txt
/tests/fixtures/game/libm-game.txt
# The 101-seed vein reference the full regression runs against. Re-export it
# with Mode = veins and Seeds = 0-100 (about 44 s per seed).
/tests/fixtures/game/vein-parity-game-0to96.txt

# tools/vein-oracle-mod is a .NET project built against the installed game
/tools/vein-oracle-mod/bin/
/tools/vein-oracle-mod/obj/

# Headless IDA workspace for UnityPlayer.dll analysis (30 MB input, ~300 MB db)
/ida-work/
